FLASK_APP=app:create_app
# Local JSON store configuration. Keep the production secret out of git.
SECRET_KEY=replace-with-a-random-local-value
JSON_FILE=instance/playtest.json
SEED_DATA=true
# Reserved for a future MySQL storage adapter; the app does not connect to MySQL yet.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=playtest
DB_PASSWORD=
DB_NAME=game_playtest
